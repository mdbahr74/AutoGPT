    smc_fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) =>
        box.new(point.new(leftTime, topPrice), point.new(rightTime + smc_fairValueGapsExtendInput * (time - time[1]), bottomPrice), xloc=xloc.bar_time, border_color=boxColor, bgcolor=boxColor)
    smc_deleteFairValueGaps() =>
        for i = smc_fairValueGaps.size() - 1 to 0
            eachFairValueGap = smc_fairValueGaps.get(i)
            if (low < eachFairValueGap.bottom and eachFairValueGap.bias == 1) or (high > eachFairValueGap.top and eachFairValueGap.bias == -1)
                eachFairValueGap.topBox.delete(), eachFairValueGap.bottomBox.delete(), smc_fairValueGaps.remove(i)
    smc_drawFairValueGaps() =>
        [lC, lO, lT, cH, cL, cT, l2H, l2L] = request.security(syminfo.tickerid, smc_fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead=barmerge.lookahead_on)
        barDeltaPercent = na(lO) or lO == 0 ? 0 : (lC - lO) / (lO * 100), newTimeframe = timeframe.change(smc_fairValueGapsTimeframeInput)
