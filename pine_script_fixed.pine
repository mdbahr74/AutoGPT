        var line topLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=levelColor, style=smc_getStyle(style)), var line bottomLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=levelColor, style=smc_getStyle(style))
        var label topLabel = label.new(na, na, xloc=xloc.bar_time, text=str.format('P{0}H', tf), color=color(na), textcolor=levelColor, size=size.small, style=label.style_label_left), var label bottomLabel = label.new(na, na, xloc=xloc.bar_time, text=str.format('P{0}L', tf), color=color(na), textcolor=levelColor, size=size.small, style=label.style_label_left)
        topLine.set_p1(point.new(parsedTopTime, parsedTop)), topLine.set_p2(point.new(last_bar_time + 20 * (time - time[1]), parsedTop)), topLabel.set_xy(point.new(last_bar_time + 20 * (time - time[1]), parsedTop))
        bottomLine.set_p1(point.new(parsedBottomTime, parsedBottom)), bottomLine.set_p2(point.new(last_bar_time + 20 * (time - time[1]), parsedBottom)), bottomLabel.set_xy(point.new(last_bar_time + 20 * (time - time[1]), parsedBottom))
