if (show_smc)
    smc_GREEN = #089981, smc_RED = #F23645, smc_BLUE = #2157f3, smc_GRAY = #878b94, smc_MONO_BULLISH = #b2b5be, smc_MONO_BEARISH = #5d606b
    smc_SMART_GROUP = 'Smart Money Concepts', smc_INTERNAL_GROUP = smc_SMART_GROUP + ' | Real Time Internal Structure', smc_SWING_GROUP = smc_SMART_GROUP + ' | Real Time Swing Structure', smc_BLOCKS_GROUP = smc_SMART_GROUP + ' | Order Blocks', smc_EQUAL_GROUP = smc_SMART_GROUP + ' | EQH/EQL', smc_GAPS_GROUP = smc_SMART_GROUP + ' | Fair Value Gaps', smc_LEVELS_GROUP = smc_SMART_GROUP + ' | Highs & Lows MTF', smc_ZONES_GROUP = smc_SMART_GROUP + ' | Premium & Discount Zones'
