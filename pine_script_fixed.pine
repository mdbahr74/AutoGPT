    smc_drawLevels(tf, sameTf, style, levelColor) =>
        [tL, bL, lT, rT] = request.security(syminfo.tickerid, tf, [high[1], low[1], time[1], time], lookahead=barmerge.lookahead_on)
        parsedTop = sameTf ? high : tL, parsedBottom = sameTf ? low : bL, parsedLeftTime = sameTf ? time : lT, parsedRightTime = sameTf ? time : rT, parsedTopTime = time, parsedBottomTime = time
