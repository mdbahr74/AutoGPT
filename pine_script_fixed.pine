    smc_internalBullColorInput = input(smc_GREEN, '', group=smc_INTERNAL_GROUP, inline='ibull')
    smc_showInternalBearInput = input.string('All', 'Bearish Structure', group=smc_INTERNAL_GROUP, inline='ibear', options=['All','BOS','CHoCH'])
    smc_internalBearColorInput = input(smc_RED, '', group=smc_INTERNAL_GROUP, inline='ibear')
    smc_internalFilterConfluenceInput = input(false, 'Confluence Filter', group=smc_INTERNAL_GROUP)
    smc_internalStructureSize = input.string(size.tiny, 'Internal Label Size', group=smc_INTERNAL_GROUP, options=[size.tiny,size.small,size.normal])
    smc_showStructureInput = input(true, 'Show Swing Structure', group=smc_SWING_GROUP)
    smc_showSwingBullInput = input.string('All', 'Bullish Structure', group=smc_SWING_GROUP, inline='bull', options=['All','BOS','CHoCH'])
    smc_swingBullColorInput = input(smc_GREEN, '', group=smc_SWING_GROUP, inline='bull')
