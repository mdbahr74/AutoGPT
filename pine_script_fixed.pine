    smc_drawHighLowSwings() =>
        var line topLine = line.new(na, na, na, na, color=smc_swingBearishColor, xloc=xloc.bar_time), var line bottomLine = line.new(na, na, na, na, color=smc_swingBullishColor, xloc=xloc.bar_time)
        var label topLabel = label.new(na, na, color=color(na), textcolor=smc_swingBearishColor, xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny), var label bottomLabel = label.new(na, na, color=color(na), textcolor=smc_swingBullishColor, xloc=xloc.bar_time, style=label.style_label_up, size=size.tiny)
        rightTimeBar = last_bar_time + 20 * (time - time[1])
        topLine.set_p1(point.new(smc_trailing.lastTopTime, smc_trailing.top)), topLine.set_p2(point.new(rightTimeBar, smc_trailing.top)), topLabel.set_xy(point.new(rightTimeBar, smc_trailing.top)), topLabel.set_text(smc_swingTrend.bias == -1 ? 'Strong High' : 'Weak High')
        bottomLine.set_p1(point.new(smc_trailing.lastBottomTime, smc_trailing.bottom)), bottomLine.set_p2(point.new(rightTimeBar, smc_trailing.bottom)), bottomLabel.set_xy(point.new(rightTimeBar, smc_trailing.bottom)), bottomLabel.set_text(smc_swingTrend.bias == 1 ? 'Strong Low' : 'Weak Low')
    smc_drawZone(labelLevel, labelIndex, top, bottom, tag, zoneColor, style) =>
        var label l_abel = label.new(na, na, text=tag, color=color(na), textcolor=zoneColor, style=style, size=size.small), var box b_ox = box.new(na, na, na, na, bgcolor=color.new(zoneColor, 80), border_color=color(na), xloc=xloc.bar_time)
        b_ox.set_top_left(point.new(smc_trailing.barTime, top)), b_ox.set_bottom_right(point.new(last_bar_time, bottom)), l_abel.set_xy(point.new(labelIndex, labelLevel))
    smc_drawPremiumDiscountZones() =>
        smc_drawZone(smc_trailing.top, math.round(0.5 * (smc_trailing.barIndex + last_bar_index)), smc_trailing.top, 0.95 * smc_trailing.top + 0.05 * smc_trailing.bottom, 'Premium', smc_premiumZoneColor, label.style_label_down)
        equilibriumLevel = math.avg(smc_trailing.top, smc_trailing.bottom)
        smc_drawZone(equilibriumLevel, last_bar_index, 0.525 * smc_trailing.top + 0.475 * smc_trailing.bottom, 0.525 * smc_trailing.bottom + 0.475 * smc_trailing.top, 'Equilibrium', smc_equilibriumZoneColorInput, label.style_label_left)
        smc_drawZone(smc_trailing.bottom, math.round(0.5 * (smc_trailing.barIndex + last_bar_index)), 0.95 * smc_trailing.bottom + 0.05 * smc_trailing.top, smc_trailing.bottom, 'Discount', smc_discountZoneColor, label.style_label_up)
    smc_parsedOpen = smc_showTrendInput ? open : na, smc_candleColor = smc_internalTrend.bias == 1 ? smc_swingBullishColor : smc_swingBearishColor
    plotcandle(smc_parsedOpen, high, low, close, color=smc_candleColor, wickcolor=smc_candleColor, bordercolor=smc_candleColor)
    if smc_showHighLowSwingsInput or smc_showPremiumDiscountZonesInput
        smc_updateTrailingExtremes()
        if smc_showHighLowSwingsInput
            smc_drawHighLowSwings()
        if smc_showPremiumDiscountZonesInput
            smc_drawPremiumDiscountZones()
    if smc_showFairValueGapsInput
        smc_deleteFairValueGaps()
    smc_getCurrentStructure(smc_swingsLengthInput, false, false), smc_getCurrentStructure(5, false, true)
    if smc_showEqualHighsLowsInput
        smc_getCurrentStructure(smc_equalHighsLowsLengthInput, true, false)
    if smc_showInternalsInput or smc_showInternalOrderBlocksInput or smc_showTrendInput
        smc_displayStructure(true)
    if smc_showStructureInput or smc_showSwingOrderBlocksInput or smc_showHighLowSwingsInput
        smc_displayStructure(false)
    if smc_showInternalOrderBlocksInput
        smc_deleteOrderBlocks(true)
    if smc_showSwingOrderBlocksInput
        smc_deleteOrderBlocks(false)
    if smc_showFairValueGapsInput
        smc_drawFairValueGaps()
    if barstate.islastconfirmedhistory or barstate.islast
        if smc_showInternalOrderBlocksInput
            smc_drawOrderBlocks(true)
        if smc_showSwingOrderBlocksInput
            smc_drawOrderBlocks(false) // 'false' is default for internal=false
    smc_lastBarIndex := smc_currentBarIndex, smc_currentBarIndex := bar_index, smc_newBar = smc_currentBarIndex != smc_lastBarIndex
    if barstate.islastconfirmedhistory or (barstate.isrealtime and smc_newBar)
        if smc_showDailyLevelsInput and not smc_higherTimeframe('D')
            smc_drawLevels('D', timeframe.isdaily, smc_dailyLevelsStyleInput, smc_dailyLevelsColorInput)
        if smc_showWeeklyLevelsInput and not smc_higherTimeframe('W')
            smc_drawLevels('W', timeframe.isweekly, smc_weeklyLevelsStyleInput, smc_weeklyLevelsColorInput)
        if smc_showMonthlyLevelsInput and not smc_higherTimeframe('M')
            smc_drawLevels('M', timeframe.ismonthly, smc_monthlyLevelsStyleInput, smc_monthlyLevelsColorInput)
    if smc_currentAlerts.internalBullishBOS
        alert('SMC: Internal Bullish BOS formed', alert.freq_once_per_bar)
    if smc_currentAlerts.internalBullishCHoCH
        alert('SMC: Internal Bullish CHoCH formed', alert.freq_once_per_bar)
    if smc_currentAlerts.swingBullishBOS
        alert('SMC: Bullish BOS formed', alert.freq_once_per_bar)
    if smc_currentAlerts.swingBullishCHoCH
        alert('SMC: Bullish CHoCH formed', alert.freq_once_per_bar)
    if smc_currentAlerts.internalBearishOrderBlock
        alert('SMC: Price broke bearish internal OB', alert.freq_once_per_bar)
    if smc_currentAlerts.equalHighs
        alert('SMC: Equal highs detected', alert.freq_once_per_bar)
    if smc_currentAlerts.bullishFairValueGap
        alert('SMC: Bullish FVG formed', alert.freq_once_per_bar)


// =============================================================================
//                      5. SESSION PROFILE MODULE
// =============================================================================
if (show_sp)
    sp_group = "Session Profile Settings"
    sp_sessionType = input.string('Daily', 'Session Type', options=['Tokyo','London','New York','Daily','Weekly', 'Monthly', 'Quarterly', 'Yearly'], group=sp_group)
    sp_display_group = sp_group + " | Display"
    sp_showProf = input.bool(true, 'Show Volume Profile', group=sp_display_group)
    sp_showSbox = input.bool(true, 'Show Session Box', group=sp_display_group)
    sp_showPoc = input.bool(true, 'Show POC', group=sp_display_group)
    sp_showVA = input.bool(true, 'Show VAH and VAL', group=sp_display_group)
    sp_showVAb = input.bool(false, 'Show Value Area Box', group=sp_display_group)
    sp_showCur = input.bool(true, 'Show Live Zone', group=sp_display_group)
    sp_showLabels = input.bool(true, 'Show Session Lables', group=sp_display_group)
    sp_showFx = input.bool(false, 'Show Forex Sessions (no profile)', group=sp_display_group)
    sp_vp_settings_group = sp_group + " | Volume Profile Settings"
    sp_resolution = input.int(30, 'Resolution', minval=5, tooltip='The higher the value, the more refined of a profile, but less profiles shown on chart', group=sp_vp_settings_group)
    sp_VAwid = input.int(70, 'Value Area Volume %', minval=1, maxval=100, group=sp_vp_settings_group)
    sp_dispMode = input.string('Mode 2', 'Bar Mode', ['Mode 1', 'Mode 2', 'Mode 3'], group=sp_vp_settings_group)
    sp_volType = input.string('Volume', 'Profile Data Type', options=['Volume', 'Open Interest'], group=sp_vp_settings_group)
    sp_smoothVol = input.bool(false, 'Smooth Volume Data', tooltip='Useful for assets that have very large spikes in volume over large bars - helps create better profiles', group=sp_vp_settings_group)
    sp_dataTf = ''
    sp_appearance_group = sp_group + " | Appearance"
    sp_bullCol = input.color(color.rgb(76, 175, 79, 50), 'Up Volume', group=sp_appearance_group)
    sp_bearCol = input.color(color.rgb(255, 82, 82, 50), 'Down Volume', group=sp_appearance_group)
    sp_VAbCol = input.color(color.rgb(107, 159, 255, 90), 'Value Area Box', group=sp_appearance_group )
    sp_pocCol = input.color(color.red, 'POC', inline='p', group=sp_appearance_group)
    sp_pocWid = input.int(1, 'Thickness', inline='p', group=sp_appearance_group)
    sp_vahCol = input.color(color.aqua, 'VAH', inline='h', group=sp_appearance_group)
    sp_vahWid = input.int(1, 'Thickness', inline='h', group=sp_appearance_group)
    sp_valCol = input.color(color.aqua, 'VAL', inline='l', group=sp_appearance_group)
    sp_valWid = input.int(1, 'Thickness', inline='l', group=sp_appearance_group)
    sp_boxBg = input.color(color.rgb(255, 153, 0, 100), 'Box', inline='m', group=sp_appearance_group)
    sp_boxWid = input.int(1, 'Thickness', inline='m', group=sp_appearance_group)

    var int sp_zoneStart = 0, var int sp_tokyoStart = 0, var int sp_londonStart = 0, var int sp_nyStart = 0
    int sp_lookback = bar_index - sp_zoneStart
    var bool sp_activeZone = false
    var sp_vpGreen = array.new_float(sp_resolution, 0), var sp_vpRed = array.new_float(sp_resolution, 0), var sp_zoneBounds = array.new_float(sp_resolution, 0)
    var array<float> sp_ltfOpen = array.new<float>(0), var array<float> sp_ltfClose = array.new<float>(0), var array<float> sp_ltfHigh = array.new<float>(0), var array<float> sp_ltfLow = array.new<float>(0), var array<float> sp_ltfVolume = array.new<float>(0)
    sp_userSymbol = syminfo.prefix + ":" + syminfo.ticker, sp_openInterestTicker = str.format("{0}_OI", sp_userSymbol), sp_timeframe = syminfo.type == "futures" and timeframe.isintraday ? "1D" : timeframe.period
    [sp_deltaOi] = request.security(sp_openInterestTicker, sp_timeframe, close-close[1], ignore_invalid_symbol = true)
    
    sp_vol() =>
        out = sp_smoothVol ? ta.ema(volume, 5) : volume
        if sp_volType == 'Open Interest'
            out := sp_deltaOi
        out
    
    [sp_dO, sp_dC, sp_dH, sp_dL, sp_dV] = request.security_lower_tf(syminfo.tickerid, sp_dataTf, [open, close, high, low, sp_vol()])

    sp_resetProfile(enable) =>
        if enable
            sp_vpGreen.fill(0), sp_vpRed.fill(0), sp_ltfOpen.clear(), sp_ltfHigh.clear(), sp_ltfLow.clear(), sp_ltfClose.clear(), sp_ltfVolume.clear()
    
    sp_profHigh = ta.highest(high, sp_lookback+1)[1]
    sp_profLow = ta.lowest(low, sp_lookback+1)[1]
    
    sp_profileAdd(o, h, l, c, v, g, w) =>
        for i = 0 to sp_vpGreen.size() - 1
            zoneTop = sp_zoneBounds.get(i), zoneBot = zoneTop - g, body_top = math.max(c, o), body_bot = math.min(c, o), itsgreen = c >= o, topwick = h - body_top, bottomwick = body_bot - l, body = body_top - body_bot
            bodyvol = body == 0 ? 0 : body * v / (2 * topwick + 2 * bottomwick + body), topwickvol = topwick == 0 ? 0 : 2 * topwick * v / (2 * topwick + 2 * bottomwick + body), bottomwickvol = bottomwick == 0 ? 0 : 2 * bottomwick * v / (2 * topwick + 2 * bottomwick + body)
            if sp_volType == 'Volume'
                sp_vpGreen.set(i, sp_vpGreen.get(i) + (itsgreen ? sp_get_vol(zoneBot, zoneTop, body_bot, body_top, body, bodyvol) : 0) + sp_get_vol(zoneBot, zoneTop, body_top, h, topwick, topwickvol) / 2 + sp_get_vol(zoneBot, zoneTop, l, body_bot, bottomwick, bottomwickvol) / 2)
                sp_vpRed.set(i, sp_vpRed.get(i) + (itsgreen ? 0 : sp_get_vol(zoneBot, zoneTop, body_bot, body_top, body, bodyvol)) + sp_get_vol(zoneBot, zoneTop, body_top, h, topwick, topwickvol) / 2 + sp_get_vol(zoneBot, zoneTop, l, body_bot, bottomwick, bottomwickvol) / 2)
            else if sp_volType == 'Open Interest'
                if v > 0
                    sp_vpGreen.set(i, sp_vpGreen.get(i) + sp_get_vol(zoneBot, zoneTop, body_bot, body_top, body, v))
                if v < 0
                    sp_vpRed.set(i, sp_vpRed.get(i) + sp_get_vol(zoneBot, zoneTop, body_bot, body_top, body, -v))

    sp_calcSession(update) =>
        sp_vpGreen.fill(0), sp_vpRed.fill(0)
        if bar_index > sp_lookback and update
            gap = (sp_profHigh - sp_profLow) / sp_resolution
            for i = 0 to sp_resolution - 1
                sp_zoneBounds.set(i, sp_profHigh - gap * i)
            if sp_ltfOpen.size() > 0
                for j = 0 to sp_ltfOpen.size() - 1
                    sp_profileAdd(sp_ltfOpen.get(j), sp_ltfHigh.get(j), sp_ltfLow.get(j), sp_ltfClose.get(j), sp_ltfVolume.get(j), gap, 1)
    
    sp_pocLevel() =>
        float maxVol = 0
        int levelInd = 0
        for i = 0 to sp_vpRed.size() - 1
            if sp_vpRed.get(i) + sp_vpGreen.get(i) > maxVol
                maxVol := sp_vpRed.get(i) + sp_vpGreen.get(i), levelInd := i
        float outLevel = na
        if levelInd != sp_vpRed.size() - 1
            outLevel := sp_zoneBounds.get(levelInd) - (sp_zoneBounds.get(levelInd) - sp_zoneBounds.get(levelInd+1)) / 2
        outLevel

    sp_valueLevels(poc) =>
        float gap = (sp_profHigh - sp_profLow) / sp_resolution, float volSum = sp_vpRed.sum() + sp_vpGreen.sum(), float volCnt = 0, float vah = sp_profHigh, float val = sp_profLow
        int pocInd = 0
        for i = 0 to sp_zoneBounds.size()-2
            if sp_zoneBounds.get(i) >= poc and sp_zoneBounds.get(i + 1) < poc
                pocInd := i
        volCnt += (sp_vpRed.get(pocInd) + sp_vpGreen.get(pocInd))
        for i = 1 to sp_vpRed.size()
            if pocInd + i >= 0 and pocInd + i < sp_vpRed.size()
                volCnt += (sp_vpRed.get(pocInd + i) + sp_vpGreen.get(pocInd + i))
                if volCnt >= volSum * (sp_VAwid/100)
                    break
                else
                    val := sp_zoneBounds.get(pocInd + i) - gap
            if pocInd - i >= 0 and pocInd - i < sp_vpRed.size()
                volCnt += (sp_vpRed.get(pocInd - i) + sp_vpGreen.get(pocInd - i))
                if volCnt >= volSum * (sp_VAwid/100)
                    break
                else
                    vah := sp_zoneBounds.get(pocInd - i)
        [val, vah]

    sp_drawNewZone(update) =>
        if bar_index > sp_lookback and update and sp_vpGreen.sum() + sp_vpRed.sum() > 0
            gap = (sp_profHigh - sp_profLow) / sp_resolution, float leftMax = bar_index[sp_lookback], float rightMax = bar_index[int(sp_lookback / 1.4)], float rightMaxVol = sp_vpGreen.max()+sp_vpRed.max(), float buffer = gap / 10
            if sp_showLabels
                label.new(math.round((bar_index - 1 + leftMax)/2), sp_profHigh, sp_sessionType, color=color.rgb(0,0,0,100), textcolor=chart.fg_color)
            if sp_showProf and not na(rightMaxVol) and rightMaxVol > 0
                for i = 0 to sp_vpRed.size() - 1
                    greenEnd = leftMax + (rightMax - leftMax) * (sp_vpGreen.get(i) / rightMaxVol), redEnd = greenEnd + (rightMax - leftMax) * (sp_vpRed.get(i) / rightMaxVol)
                    if sp_dispMode == 'Mode 2'
                        box.new(int(leftMax), sp_zoneBounds.get(i) - buffer, int(greenEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bullCol, border_width=0), box.new(int(greenEnd), sp_zoneBounds.get(i) - buffer, int(redEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bearCol, border_width=0)
                    else if sp_dispMode == 'Mode 1'
                        box.new(int(leftMax), sp_zoneBounds.get(i) - buffer, int(greenEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bullCol, border_width=0)
                    else
                        box.new(int(leftMax), sp_zoneBounds.get(i) - buffer, int(greenEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bullCol, border_width=0), box.new(int(leftMax)-int(redEnd)+int(greenEnd), sp_zoneBounds.get(i) - buffer, int(leftMax), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bearCol, border_width=0)
            if sp_showSbox
                box.new(int(leftMax), sp_profHigh, bar_index-1, sp_profLow, color = chart.fg_color, width = sp_boxWid, style = line.style_dashed, bgcolor=sp_boxBg)
            poc = sp_pocLevel(), [val, vah] = sp_valueLevels(poc)
            if sp_showPoc
                line.new(int(leftMax), poc, bar_index-1, poc, color=sp_pocCol, width=sp_pocWid)
            if sp_showVA
                line.new(int(leftMax), vah, bar_index-1, vah, color=sp_vahCol, width=sp_vahWid), line.new(int(leftMax), val, bar_index-1, val, color=sp_valCol, width=sp_valWid)
            if sp_showVAb
                box.new(int(leftMax), vah, bar_index-1, val, border_color=color.rgb(54, 58, 69, 100), bgcolor=sp_VAbCol)

    sp_drawCurZone(update, delete) =>
        var line pocLine = na, var line vahLine = na, var line valLine = na, var box outBox = na, var label sessionLab = na
        var array<box> redBoxes = array.new_box(sp_vpRed.size(), na), var array<box> greenBoxes = array.new_box(sp_vpRed.size(), na)
        if bar_index > sp_lookback and update and sp_vpGreen.sum() + sp_vpRed.sum() > 0
            if not na(pocLine)
                pocLine.delete()
            if not na(vahLine)
                vahLine.delete()
            if not na(valLine)
                valLine.delete()
            if not na(outBox)
                outBox.delete()
            if not na(sessionLab)
                sessionLab.delete()
            for i = 0 to redBoxes.size() - 1
                if not na(redBoxes.get(i))
                    redBoxes.get(i).delete()
                if not na(greenBoxes.get(i))
                    greenBoxes.get(i).delete()
            gap = (sp_profHigh - sp_profLow) / sp_resolution, float leftMax = bar_index[sp_lookback], float rightMax = bar_index[int(sp_lookback / 1.4)], float rightMaxVol = sp_vpGreen.max()+sp_vpRed.max(), float buffer = gap / 10
            if sp_showLabels
                sessionLab := label.new(math.round((bar_index - 1 + leftMax)/2), sp_profHigh, sp_sessionType, color=color.rgb(0,0,0,100), textcolor=chart.fg_color)
            if sp_showProf and not na(rightMaxVol) and rightMaxVol > 0
                for i = 0 to sp_vpRed.size() - 1
                    greenEnd = leftMax + (rightMax - leftMax) * (sp_vpGreen.get(i) / rightMaxVol), redEnd = greenEnd + (rightMax - leftMax) * (sp_vpRed.get(i) / rightMaxVol)
                    if sp_dispMode == 'Mode 2'
                        greenBoxes.set(i, box.new(int(leftMax), sp_zoneBounds.get(i) - buffer, int(greenEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bullCol, border_width=0)), redBoxes.set(i, box.new(int(greenEnd), sp_zoneBounds.get(i) - buffer, int(redEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bearCol, border_width=0))
                    else if sp_dispMode == 'Mode 1'
                        greenBoxes.set(i, box.new(int(leftMax), sp_zoneBounds.get(i) - buffer, int(greenEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bullCol, border_width=0))
                    else
                        greenBoxes.set(i, box.new(int(leftMax), sp_zoneBounds.get(i) - buffer, int(greenEnd), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bullCol, border_width=0)), redBoxes.set(i, box.new(int(leftMax)-int(redEnd)+int(greenEnd), sp_zoneBounds.get(i) - buffer, int(leftMax), sp_zoneBounds.get(i) - gap + buffer, bgcolor=sp_bearCol, border_width=0))
            if sp_showSbox
                outBox := box.new(int(leftMax), sp_profHigh, bar_index-1, sp_profLow, color = chart.fg_color, width = sp_boxWid, style = line.style_dashed, bgcolor=sp_boxBg)
            poc = sp_pocLevel(), [val, vah] = sp_valueLevels(poc)
            if sp_showPoc
                pocLine.delete(), pocLine := line.new(int(leftMax), poc, bar_index-1, poc, color=sp_pocCol, width=sp_pocWid)
            if sp_showVA
                vahLine.delete(), valLine.delete(), vahLine := line.new(int(leftMax), vah, bar_index-1, vah, color=sp_vahCol, width=sp_vahWid), valLine := line.new(int(leftMax), val, bar_index-1, val, color=sp_valCol, width=sp_valWid)
            if sp_showVAb
                box.new(int(leftMax), vah, bar_index-1, val, border_color=color.rgb(54, 58, 69, 100), bgcolor=sp_VAbCol)
        if delete
            if not na(outBox)
                outBox.delete()
            if not na(pocLine)
                pocLine.delete()
            if not na(vahLine)
                vahLine.delete()
            if not na(valLine)
                valLine.delete()
            for i = 0 to greenBoxes.size()-1
                if not na(greenBoxes.get(i))
                    greenBoxes.get(i).delete()
            for i = 0 to redBoxes.size()-1
                if not na(redBoxes.get(i))
                    redBoxes.get(i).delete()
    
    sp_drawForexBox(startBar, title, top, bottom) =>
        box.new(int(startBar), top, bar_index-1, bottom, color = chart.fg_color, width = sp_boxWid, style = line.style_dashed, bgcolor=sp_boxBg)
        if sp_showLabels
            label.new(math.round((bar_index - 1 + startBar)/2), top, title, color=color.rgb(0,0,0,100), textcolor=chart.fg_color)
    
    sp_updateIntra(o, h, l, c, v) =>
        if not na(o)
            sp_ltfOpen.push(o), sp_ltfHigh.push(h), sp_ltfLow.push(l), sp_ltfClose.push(c), sp_ltfVolume.push(v)

    sp_newDaily = dayofweek != dayofweek[1], sp_newWeekly = weekofyear != weekofyear[1], sp_newMonthly = month != month[1] and dayofmonth < dayofmonth[1], sp_newYearly = year != year[1], sp_newQuarterly = month != month[1] and (month - 1) % 3 == 0
    sp_utcHour = hour(time(timeframe.period, '0000-2400', 'GMT'), 'GMT')
    sp_newTokyo = sp_utcHour == 0 and sp_utcHour[1] == 23, sp_endTokyo = sp_utcHour >= 9 and sp_utcHour[1] < 9
    sp_newLondon = sp_utcHour >= 7 and sp_utcHour[1] < 7, sp_endLondon = sp_utcHour >= 16 and sp_utcHour[1] < 16
    sp_newNewYork = sp_utcHour >= 13 and sp_utcHour[1] < 13, sp_endNewYork = sp_utcHour >= 22 and sp_utcHour[1] < 22
    sp_newSession = switch sp_sessionType
        'Tokyo' => sp_newTokyo, 'London' => sp_newLondon, 'New York' => sp_newNewYork, 'Daily' => sp_newDaily, 'Weekly' => sp_newWeekly, 'Monthly' => sp_newMonthly, 'Yearly' => sp_newYearly, 'Quarterly' => sp_newQuarterly, => sp_newDaily
    sp_zoneEnd = switch sp_sessionType
        'Tokyo' => sp_endTokyo, 'London' => sp_endLondon, 'New York' => sp_endNewYork, 'Daily' => sp_newDaily, 'Weekly' => sp_newWeekly, 'Monthly' => sp_newMonthly, 'Yearly' => sp_newYearly, 'Quarterly' => sp_newQuarterly, => sp_newDaily
    
    sp_calcSession(sp_zoneEnd or (barstate.islast and sp_showCur))
    sp_drawNewZone(sp_zoneEnd)
    sp_drawCurZone(barstate.islast and not sp_zoneEnd and sp_showCur and sp_activeZone, sp_zoneEnd)
    sp_resetProfile(sp_newSession)
    sp_updateIntra(sp_dO, sp_dH, sp_dL, sp_dC, sp_dV)
    if sp_zoneEnd
        sp_activeZone := false
    if sp_newSession
        sp_zoneStart := bar_index, sp_activeZone := true
    if sp_newLondon
        sp_londonStart := bar_index
    if sp_newTokyo
        sp_tokyoStart := bar_index
    if sp_newNewYork
        sp_nyStart := bar_index
    sp_londonHigh = ta.highest(high, bar_index-sp_londonStart+1), sp_tokyoHigh = ta.highest(high, bar_index-sp_tokyoStart+1), sp_nyHigh = ta.highest(high, bar_index-sp_nyStart+1)
    sp_londonLow = ta.lowest(low, bar_index-sp_londonStart+1), sp_tokyoLow = ta.lowest(low, bar_index-sp_tokyoStart+1), sp_nyLow = ta.lowest(low, bar_index-sp_nyStart+1)
    if sp_endLondon and sp_showFx
        sp_drawForexBox(sp_londonStart, 'London', sp_londonHigh, sp_londonLow)
    if sp_endNewYork and sp_showFx
        sp_drawForexBox(sp_nyStart, 'New York', sp_nyHigh, sp_nyLow)
    if sp_endTokyo and sp_showFx
        sp_drawForexBox(sp_tokyoStart, 'Tokyo', sp_tokyoHigh, sp_tokyoLow)
